{
  "name": "circuito",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/build-pwa.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {"react": "19.2.0", "react-dom": "19.2.0"},
  "devDependencies": {
    "@types/react": "19.2.2", "@types/react-dom": "19.2.2",
    "@types/node": "22.18.6", "typescript": "5.9.3", "vite": "7.3.1",
    "tsx": "4.20.6", "@playwright/test": "1.56.1", "fake-indexeddb": "6.2.4"
  }
}
